# Application
APP_NAME=SkillSync
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (MongoDB)
DATABASE_URL="mongodb://localhost:27017/skillsync_db"
MONGODB_URI="mongodb://localhost:27017/skillsync_db"

# Authentication
JWT_SECRET=your-very-secret-jwt-key-minimum-32-chars-change-this
JWT_REFRESH_SECRET=your-very-secret-refresh-key-minimum-32-chars-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=your-session-secret-key-minimum-32-chars

# AI Provider (Gemini)
# Leave blank to use demo/fallback mode
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
AI_DEMO_MODE=true

# Storage
STORAGE_PROVIDER=local
# For MinIO/S3:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillsync-uploads
S3_ACCESS_KEY=skillsync_minio
S3_SECRET_KEY=skillsync_minio_password

# Redis
REDIS_URL=redis://:skillsync_redis_password@localhost:6379

# Email (SMTP) — Leave blank to log emails to console in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@skillsync.local

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
